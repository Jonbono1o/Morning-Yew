<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Morning Yew" />
<meta name="mobile-web-app-capable" content="yes" />
<title>Morning Yew</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --yew-deep:#1B3328;
    --yew-deeper:#122019;
    --parchment:#F3ECDB;
    --parchment-dim:#E4DBC4;
    --brass:#B98B4E;
    --brass-bright:#DDAE66;
    --moss:#7FA07A;
    --clay:#A85C3F;
    --charcoal:#16211B;
    --ink:#EFE9DA;
    --ink-dim:#B9C4B9;
    --line: rgba(239,233,218,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: radial-gradient(120% 140% at 50% -10%, var(--yew-deep) 0%, var(--yew-deeper) 65%);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  #app{
    max-width:480px;
    margin:0 auto;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    padding-bottom:78px;
  }
  header{
    padding:28px 22px 14px;
    border-bottom:1px solid var(--line);
  }
  header .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--brass-bright);
    margin-bottom:6px;
  }
  header h1{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:28px;
    margin:0;
    letter-spacing:.01em;
  }
  header p.sub{
    margin:6px 0 0;
    color:var(--ink-dim);
    font-size:13.5px;
  }
  main{flex:1; padding:20px 18px 10px;}
  .tab{display:none;}
  .tab.active{display:block; animation:fade .25s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;}}

  .card{
    background:rgba(243,236,219,0.05);
    border:1px solid var(--line);
    border-radius:16px;
    padding:18px;
    margin-bottom:16px;
  }
  label{
    display:block;
    font-size:11.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-dim);
    margin-bottom:7px;
    font-family:'JetBrains Mono',monospace;
  }
  select, input[type=text], input[type=number]{
    width:100%;
    background:var(--charcoal);
    border:1px solid var(--line);
    color:var(--ink);
    padding:11px 12px;
    border-radius:10px;
    font-family:'Inter',sans-serif;
    font-size:15px;
    outline:none;
  }
  select:focus, input:focus{border-color:var(--brass);}
  .row{display:flex; gap:12px;}
  .row > div{flex:1;}
  .field{margin-bottom:14px;}

  button{
    font-family:'Inter',sans-serif;
    border:none;
    cursor:pointer;
    border-radius:10px;
    font-weight:600;
    font-size:14.5px;
  }
  .btn-primary{
    background:var(--brass);
    color:var(--charcoal);
    padding:13px 18px;
    width:100%;
  }
  .btn-primary:active{background:var(--brass-bright);}
  .btn-ghost{
    background:transparent;
    border:1px solid var(--line);
    color:var(--ink);
    padding:13px 18px;
    width:100%;
  }
  .btn-stop{
    background:var(--clay);
    color:var(--parchment);
    padding:13px 18px;
    width:100%;
  }
  .btn-row{display:flex; gap:10px; margin-top:6px;}
  .btn-row > button{flex:1;}
  .btn-small{
    background:rgba(185,139,78,0.16);
    color:var(--brass-bright);
    padding:9px 12px;
    font-size:13px;
    white-space:nowrap;
  }
  .link-btn{
    background:none;
    color:var(--ink-dim);
    font-size:12.5px;
    text-decoration:underline;
    padding:4px 0;
  }

  /* Plant picker */
  .plant-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-top:4px;}
  .plant-card{
    border:1px solid var(--line); border-radius:14px; padding:16px 10px; text-align:center;
    background:rgba(185,139,78,0.06); cursor:pointer;
  }
  .plant-card.active{ border-color:var(--brass); background:rgba(185,139,78,0.2);}
  .plant-card svg{ width:26px; height:26px;}
  .plant-card path{ fill:var(--moss);}
  .plant-card .name{ font-family:'Fraunces',serif; font-size:14.5px; margin-top:8px;}

  /* Dial */
  .dial-wrap{
    display:flex; flex-direction:column; align-items:center; padding:6px 0 4px;
  }
  .dial{ position:relative; width:220px; height:220px;}
  .dial svg{ width:100%; height:100%; }
  .dial-track{ fill:none; stroke:rgba(239,233,218,0.12); stroke-width:10;}
  .dial-progress{ fill:none; stroke:var(--brass-bright); stroke-width:10; stroke-linecap:round; transition:stroke-dashoffset .18s linear;}
  .dial-center{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
  }
  #timer-seconds{
    font-family:'JetBrains Mono',monospace;
    font-size:52px; font-weight:700; color:var(--ink); line-height:1;
  }
  #timer-label{
    font-size:11.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-dim); margin-top:6px; font-family:'JetBrains Mono',monospace;
  }
  #timer-status{
    text-align:center; font-family:'Fraunces',serif; font-size:17px; margin:10px 0 2px; color:var(--brass-bright); min-height:22px;
  }

  .tally{ display:flex; flex-wrap:wrap; gap:7px; justify-content:center; margin:14px 0 4px;}
  .sprig{ width:16px; height:16px; opacity:.35; transition:opacity .2s, transform .2s;}
  .sprig.done{ opacity:1;}
  .sprig.current{ opacity:1; transform:scale(1.25);}
  .sprig path{ fill:var(--moss); }
  .sprig.pending path{ fill:var(--ink-dim); }

  /* Stats strip */
  .stat-strip{ display:flex; gap:10px; overflow-x:auto; padding-bottom:4px; margin-bottom:4px;}
  .stat-pill{
    flex:0 0 auto; background:rgba(185,139,78,0.1); border:1px solid var(--line);
    border-radius:12px; padding:12px 14px; min-width:130px;
  }
  .stat-pill .n{ font-family:'JetBrains Mono',monospace; font-size:22px; color:var(--brass-bright); font-weight:700;}
  .stat-pill .l{ font-size:11.5px; color:var(--ink-dim); margin-top:3px;}

  /* Calendar */
  .cal-header{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;}
  .cal-header button{ background:none; color:var(--ink-dim); font-size:20px; padding:2px 12px;}
  .cal-title{ font-family:'Fraunces',serif; font-size:16.5px;}
  .cal-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:4px; text-align:center;}
  .cal-wd{ font-size:10px; color:var(--ink-dim); font-family:'JetBrains Mono',monospace; padding-bottom:6px;}
  .cal-day{ position:relative; aspect-ratio:1; display:flex; align-items:center; justify-content:center;
    border-radius:9px; font-size:13px; cursor:pointer; color:var(--ink);}
  .cal-day.blank{ visibility:hidden; cursor:default;}
  .cal-day.today{ box-shadow: inset 0 0 0 1px var(--brass-bright);}
  .cal-day.selected{ background:var(--brass); color:var(--charcoal); font-weight:700;}
  .cal-day .dot{ position:absolute; bottom:4px; width:4px; height:4px; border-radius:50%; background:var(--moss);}
  .cal-day.selected .dot{ background:var(--charcoal);}
  .day-detail{ margin-top:16px; border-top:1px solid var(--line); padding-top:14px;}
  .day-detail h4{ font-family:'Fraunces',serif; font-size:15px; margin:0 0 8px; font-weight:600;}

  .log-entry{
    display:flex; justify-content:space-between; align-items:center;
    padding:12px 0; border-bottom:1px solid var(--line);
  }
  .log-entry:last-child{border-bottom:none;}
  .log-entry .cat{ font-family:'Fraunces',serif; font-size:16px; }
  .log-entry .meta{ font-size:12.5px; color:var(--ink-dim); margin-top:2px;}
  .log-entry .del{ background:none; color:var(--ink-dim); font-size:18px; padding:4px 8px;}
  .empty{ color:var(--ink-dim); font-size:13.5px; text-align:center; padding:20px 10px;}

  /* Forecast */
  .forecast-card{
    border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin-bottom:10px;
    background:rgba(243,236,219,0.04);
  }
  .forecast-card .top{ display:flex; justify-content:space-between; align-items:baseline;}
  .forecast-card .date{ font-family:'Fraunces',serif; font-size:16px;}
  .forecast-card .temps{ font-family:'JetBrains Mono',monospace; font-size:13.5px; color:var(--ink-dim);}
  .forecast-card .cond{ font-size:13px; color:var(--brass-bright); margin-top:4px;}
  .forecast-card .advice{ font-size:13.5px; margin-top:8px; line-height:1.45;}
  .forecast-meta{ font-size:11.5px; color:var(--ink-dim); text-align:center; margin-top:6px;}

  .toast{
    position:fixed; bottom:92px; left:50%; transform:translateX(-50%) translateY(10px);
    background:var(--brass); color:var(--charcoal); padding:10px 18px; border-radius:20px;
    font-size:13.5px; font-weight:600; opacity:0; pointer-events:none; transition:all .25s;
    max-width:90%; text-align:center;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0);}

  nav.tabbar{
    position:fixed; bottom:0; left:0; right:0;
    background:rgba(18,32,25,0.92); backdrop-filter:blur(10px);
    border-top:1px solid var(--line);
    display:flex; max-width:480px; margin:0 auto;
  }
  nav.tabbar button{
    flex:1; background:none; padding:12px 4px 10px; display:flex; flex-direction:column; align-items:center; gap:4px;
    color:var(--ink-dim); font-size:11px; font-weight:500;
  }
  nav.tabbar button.active{ color:var(--brass-bright);}
  nav.tabbar svg{ width:20px; height:20px;}

  .add-cat{ margin-top:12px; }
  .add-cat.hidden{ display:none;}
  .hidden{ display:none !important;}

  ::placeholder{ color:rgba(185,196,185,0.5);}
</style>
</head>
<body>
<div id="app">
  <header>
    <div class="eyebrow">Garden · Watering Log</div>
    <h1>Morning Yew</h1>
    <p class="sub">Time it, log it, know when it's due again.</p>
  </header>

  <main>
    <!-- WATER TAB -->
    <section class="tab active" id="tab-water">

      <div id="plant-picker">
        <div class="card">
          <label>What are you watering?</label>
          <div class="plant-grid" id="plant-grid"></div>
          <button class="link-btn" id="toggle-add-cat" style="margin-top:12px;">+ Add a new plant category</button>
          <div class="add-cat hidden" id="add-cat-form">
            <div class="row" style="margin-top:8px;">
              <div class="field">
                <label>Name</label>
                <input type="text" id="new-cat-name" placeholder="e.g. Roses" />
              </div>
              <div class="field" style="max-width:110px;">
                <label>Secs each</label>
                <input type="number" id="new-cat-secs" value="30" min="1" />
              </div>
            </div>
            <button class="btn-small" id="save-cat" style="width:100%;">Add category</button>
          </div>
        </div>
      </div>

      <div id="round-setup" class="hidden">
        <div class="card">
          <div class="row" style="align-items:center;">
            <div style="flex:1;">
              <label style="margin-bottom:2px;">Watering</label>
              <div id="selected-plant-name" style="font-family:'Fraunces',serif; font-size:18px;"></div>
            </div>
            <button class="btn-small" id="change-plant">Change</button>
          </div>
          <div class="row" style="margin-top:14px;">
            <div class="field">
              <label for="count-input">Plants this round</label>
              <input type="number" id="count-input" min="1" value="1" />
            </div>
            <div class="field">
              <label>Seconds each</label>
              <div style="padding:11px 0; font-family:'JetBrains Mono',monospace; font-size:15px;" id="secs-each-display">30s</div>
            </div>
          </div>
        </div>

        <div class="card dial-wrap">
          <div class="dial">
            <svg viewBox="0 0 200 200">
              <circle class="dial-track" cx="100" cy="100" r="85"/>
              <circle class="dial-progress" id="dial-progress" cx="100" cy="100" r="85" transform="rotate(-90 100 100)"/>
            </svg>
            <div class="dial-center">
              <div id="timer-seconds">30</div>
              <div id="timer-label">seconds</div>
            </div>
          </div>
          <div id="timer-status">Ready when you are</div>
          <div class="tally" id="tally"></div>

          <div class="btn-row" style="width:100%; margin-top:6px;" id="start-controls">
            <button class="btn-primary" id="btn-start">Start watering round</button>
          </div>
          <div class="btn-row hidden" style="width:100%;" id="running-controls">
            <button class="btn-ghost" id="btn-pause">Pause</button>
            <button class="btn-stop" id="btn-stop">Finish & log</button>
          </div>
        </div>
      </div>
    </section>

    <!-- LOG TAB -->
    <section class="tab" id="tab-log">
      <div class="stat-strip" id="stat-strip"></div>
      <div class="card">
        <div class="cal-header">
          <button id="cal-prev">‹</button>
          <div class="cal-title" id="cal-title"></div>
          <button id="cal-next">›</button>
        </div>
        <div class="cal-grid" id="cal-grid"></div>
        <div class="day-detail" id="day-detail"></div>
      </div>
    </section>

    <!-- FORECAST TAB -->
    <section class="tab" id="tab-forecast">
      <div class="card">
        <div class="field">
          <label for="location-input">Your location</label>
          <input type="text" id="location-input" placeholder="e.g. Bath, UK" />
        </div>
        <button class="btn-primary" id="btn-get-forecast">Get forecast & watering advice</button>
        <div class="forecast-meta" id="forecast-meta"></div>
      </div>
      <div id="forecast-list"></div>
    </section>
  </main>

  <div class="toast" id="toast"></div>

  <nav class="tabbar">
    <button data-tab="water" class="active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2s7 8.5 7 13a7 7 0 1 1-14 0c0-4.5 7-13 7-13z"/></svg>
      Water
    </button>
    <button data-tab="log">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
      Calendar
    </button>
    <button data-tab="forecast">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.6 1.5A4 4 0 0 0 6.5 19h11z"/></svg>
      Forecast
    </button>
  </nav>
</div>

<script>
const CIRC = 2 * Math.PI * 85;
document.getElementById('dial-progress').style.strokeDasharray = CIRC;
document.getElementById('dial-progress').style.strokeDashoffset = CIRC;

let categories = [];
let sessions = [];
let settings = { location: '' };
let audioCtx = null;
let selectedCategoryId = null;

let calendarMonth = new Date();
let selectedDay = todayKey();

let timer = {
  running:false, paused:false,
  categoryId:null, categoryName:'', intervalSeconds:30,
  totalCount:0, completedCount:0,
  targetEnd:0, remainingMs:30000, pausedRemaining:0,
  tickHandle:null, startedAt:null
};

function todayKey(){
  const d = new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function dateKey(iso){
  const d = new Date(iso);
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}

// ---------- storage helpers ----------
async function loadJSON(key, fallback){
  try{
    const r = await window.storage.get(key, false);
    return r ? JSON.parse(r.value) : fallback;
  }catch(e){ return fallback; }
}
async function saveJSON(key, val){
  try{ await window.storage.set(key, JSON.stringify(val), false); }
  catch(e){ console.error('storage save failed', key, e); }
}

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._h);
  t._h = setTimeout(()=>t.classList.remove('show'), 2200);
}

// ---------- init ----------
async function init(){
  categories = await loadJSON('categories', null);
  if(!categories){
    categories = [{id:'yew', name:'Yew Hedge', seconds:30, lastCount:10}];
    await saveJSON('categories', categories);
  }
  sessions = await loadJSON('sessions', []);
  settings = await loadJSON('settings', {location:''});
  document.getElementById('location-input').value = settings.location || '';

  const cache = await loadJSON('forecast-cache', null);

  renderPlantGrid();
  renderCalendar();
  if(cache) renderForecast(cache);

  bindEvents();
}

// ---------- plant picker ----------
function sprigSVG(cls){
  return `<svg class="sprig ${cls}" viewBox="0 0 24 24"><path d="M12 2c-2 4-2 7 0 10 2-3 2-6 0-10zM4 10c3 1 5 3 6 6-3 0-6-2-6-6zM20 10c-3 1-5 3-6 6 3 0 6-2 6-6zM12 12v10"/></svg>`;
}
function renderPlantGrid(){
  const grid = document.getElementById('plant-grid');
  grid.innerHTML = categories.map(c => `
    <div class="plant-card ${c.id===selectedCategoryId?'active':''}" data-cat="${c.id}">
      <svg viewBox="0 0 24 24"><path d="M12 2c-2 4-2 7 0 10 2-3 2-6 0-10zM4 10c3 1 5 3 6 6-3 0-6-2-6-6zM20 10c-3 1-5 3-6 6 3 0 6-2 6-6zM12 12v10"/></svg>
      <div class="name">${escapeHtml(c.name)}</div>
    </div>
  `).join('');
}
function pickCategory(id){
  selectedCategoryId = id;
  const cat = categories.find(c=>c.id===id);
  if(!cat) return;
  document.getElementById('selected-plant-name').textContent = cat.name;
  document.getElementById('secs-each-display').textContent = cat.seconds + 's';
  document.getElementById('count-input').value = cat.lastCount || 1;
  resetDialDisplay(cat.seconds);
  document.getElementById('plant-picker').classList.add('hidden');
  document.getElementById('round-setup').classList.remove('hidden');
}
function currentCategory(){
  return categories.find(c=>c.id===selectedCategoryId);
}

// ---------- timer ----------
function resetDialDisplay(seconds){
  document.getElementById('timer-seconds').textContent = seconds;
  document.getElementById('dial-progress').style.strokeDashoffset = CIRC;
  document.getElementById('timer-status').textContent = 'Ready when you are';
  document.getElementById('tally').innerHTML = '';
}
function renderTally(){
  const wrap = document.getElementById('tally');
  let html = '';
  for(let i=0;i<timer.totalCount;i++){
    let cls = 'pending';
    if(i < timer.completedCount) cls = 'done';
    else if(i === timer.completedCount && timer.running) cls = 'current';
    html += sprigSVG(cls);
  }
  wrap.innerHTML = html;
}

function ensureAudio(){
  if(!audioCtx){
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  if(audioCtx.state === 'suspended') audioCtx.resume();
}
function beep(freq, startOffset, dur, type){
  const o = audioCtx.createOscillator();
  const g = audioCtx.createGain();
  o.type = type || 'sine';
  o.frequency.value = freq;
  g.gain.setValueAtTime(0.0001, audioCtx.currentTime + startOffset);
  g.gain.exponentialRampToValueAtTime(0.45, audioCtx.currentTime + startOffset + 0.02);
  g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + startOffset + dur);
  o.connect(g); g.connect(audioCtx.destination);
  o.start(audioCtx.currentTime + startOffset);
  o.stop(audioCtx.currentTime + startOffset + dur + 0.02);
}
// Longer, louder alert pattern (~2.4s of pulses) so it cuts through other audio
// playing on the same device. Note: browsers can't guarantee ducking another
// app's audio, so this works best while Morning Yew's tab stays open/foregrounded.
function playNextAlarm(){
  ensureAudio();
  const times = [0, 0.32, 0.64, 0.96, 1.28, 1.6, 1.92];
  times.forEach(t => beep(880, t, 0.24, 'square'));
  if(navigator.vibrate) try{navigator.vibrate([180,90,180,90,180,90,180,90,180,90,180]);}catch(e){}
}
function playFinishAlarm(){
  ensureAudio();
  const seq = [[880,0],[1046,0.34],[1318,0.68],[880,1.1],[1046,1.44],[1318,1.78],[1568,2.15]];
  seq.forEach(([f,t]) => beep(f, t, 0.28, 'square'));
  if(navigator.vibrate) try{navigator.vibrate([200,90,200,90,200,90,200,90,450]);}catch(e){}
}

function startTimer(){
  const cat = currentCategory();
  if(!cat){ toast('Pick a plant first'); return; }
  const count = parseInt(document.getElementById('count-input').value, 10) || 1;
  if(count < 1){ toast('Enter at least 1 plant'); return; }

  ensureAudio();

  timer.running = true;
  timer.paused = false;
  timer.categoryId = cat.id;
  timer.categoryName = cat.name;
  timer.intervalSeconds = cat.seconds;
  timer.totalCount = count;
  timer.completedCount = 0;
  timer.startedAt = Date.now();
  timer.targetEnd = Date.now() + cat.seconds * 1000;

  document.getElementById('start-controls').classList.add('hidden');
  document.getElementById('running-controls').classList.remove('hidden');
  document.getElementById('running-controls').style.display = 'flex';
  document.getElementById('change-plant').disabled = true;
  document.getElementById('timer-status').textContent = `Plant 1 of ${count} — ${cat.name}`;
  renderTally();

  clearInterval(timer.tickHandle);
  timer.tickHandle = setInterval(tick, 100);
  tick();
}

function tick(){
  if(!timer.running || timer.paused) return;
  const remaining = Math.max(0, timer.targetEnd - Date.now());
  const secs = Math.ceil(remaining/1000);
  document.getElementById('timer-seconds').textContent = secs;
  const frac = remaining / (timer.intervalSeconds*1000);
  document.getElementById('dial-progress').style.strokeDashoffset = CIRC * frac;

  if(remaining <= 0){
    timer.completedCount++;
    if(timer.completedCount >= timer.totalCount){
      playFinishAlarm();
      finishTimer(true);
      return;
    } else {
      playNextAlarm();
      timer.targetEnd = Date.now() + timer.intervalSeconds*1000;
      document.getElementById('timer-status').textContent = `Plant ${timer.completedCount+1} of ${timer.totalCount} — ${timer.categoryName}`;
      renderTally();
    }
  }
}

function pauseTimer(){
  if(!timer.running) return;
  if(!timer.paused){
    timer.paused = true;
    timer.pausedRemaining = Math.max(0, timer.targetEnd - Date.now());
    document.getElementById('btn-pause').textContent = 'Resume';
    document.getElementById('timer-status').textContent = 'Paused';
  } else {
    timer.paused = false;
    timer.targetEnd = Date.now() + timer.pausedRemaining;
    document.getElementById('btn-pause').textContent = 'Pause';
    document.getElementById('timer-status').textContent = `Plant ${timer.completedCount+1} of ${timer.totalCount} — ${timer.categoryName}`;
  }
}

async function finishTimer(completedAll){
  clearInterval(timer.tickHandle);
  timer.running = false;

  const wasCount = timer.completedCount;
  if(wasCount > 0){
    const durationSeconds = wasCount * timer.intervalSeconds;
    const entry = {
      id: 's_' + Date.now(),
      date: new Date().toISOString(),
      categoryId: timer.categoryId,
      categoryName: timer.categoryName,
      count: wasCount,
      durationSeconds
    };
    sessions.unshift(entry);
    await saveJSON('sessions', sessions);

    const cat = categories.find(c=>c.id===timer.categoryId);
    if(cat){ cat.lastCount = wasCount; await saveJSON('categories', categories); }

    selectedDay = dateKey(entry.date);
    calendarMonth = new Date(entry.date);
    renderCalendar();
    toast(completedAll ? `Logged: ${wasCount} ${timer.categoryName} watered` : `Logged ${wasCount} of ${timer.totalCount} before stopping`);
  } else {
    toast('Round stopped — nothing logged');
  }

  document.getElementById('start-controls').classList.remove('hidden');
  document.getElementById('running-controls').classList.add('hidden');
  document.getElementById('btn-pause').textContent = 'Pause';
  document.getElementById('change-plant').disabled = false;
  const cat = currentCategory();
  resetDialDisplay(timer.intervalSeconds || (cat ? cat.seconds : 30));
}

// ---------- calendar / log tab ----------
function fmtTime(iso){
  return new Date(iso).toLocaleTimeString(undefined, {hour:'2-digit', minute:'2-digit'});
}
function daysSince(iso){
  return Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
}
function sessionsByDay(){
  const map = {};
  sessions.forEach(s=>{
    const k = dateKey(s.date);
    (map[k] = map[k] || []).push(s);
  });
  return map;
}
function renderStatStrip(){
  const stripEl = document.getElementById('stat-strip');
  const latestByCat = {};
  sessions.forEach(s=>{
    if(!latestByCat[s.categoryId] || new Date(s.date) > new Date(latestByCat[s.categoryId].date)){
      latestByCat[s.categoryId] = s;
    }
  });
  stripEl.innerHTML = categories.map(c=>{
    const last = latestByCat[c.id];
    const val = last ? daysSince(last.date) : null;
    return `<div class="stat-pill">
      <div class="n">${val===null ? '—' : (val===0?'Today':val+'d')}</div>
      <div class="l">${escapeHtml(c.name)} last watered</div>
    </div>`;
  }).join('');
}
function renderCalendar(){
  renderStatStrip();
  const byDay = sessionsByDay();
  const year = calendarMonth.getFullYear();
  const month = calendarMonth.getMonth();
  document.getElementById('cal-title').textContent =
    calendarMonth.toLocaleDateString(undefined, {month:'long', year:'numeric'});

  const firstWeekday = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month+1, 0).getDate();
  const wdLabels = ['S','M','T','W','T','F','S'];

  let html = wdLabels.map(w=>`<div class="cal-wd">${w}</div>`).join('');
  for(let i=0;i<firstWeekday;i++) html += `<div class="cal-day blank"></div>`;
  for(let d=1; d<=daysInMonth; d++){
    const key = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const has = !!byDay[key];
    const isToday = key === todayKey();
    const isSel = key === selectedDay;
    html += `<div class="cal-day ${isToday?'today':''} ${isSel?'selected':''}" data-day="${key}">
      ${d}${has?'<span class="dot"></span>':''}
    </div>`;
  }
  document.getElementById('cal-grid').innerHTML = html;
  renderDayDetail(byDay);
}
function renderDayDetail(byDay){
  byDay = byDay || sessionsByDay();
  const entries = byDay[selectedDay] || [];
  const label = new Date(selectedDay + 'T12:00:00').toLocaleDateString(undefined, {weekday:'long', day:'numeric', month:'long'});
  const detail = document.getElementById('day-detail');
  if(entries.length === 0){
    detail.innerHTML = `<h4>${label}</h4><div class="empty">Nothing logged this day.</div>`;
    return;
  }
  detail.innerHTML = `<h4>${label}</h4>` + entries.map(s=>`
    <div class="log-entry">
      <div>
        <div class="cat">${escapeHtml(s.categoryName)}</div>
        <div class="meta">${fmtTime(s.date)} · ${s.count} plant${s.count===1?'':'s'} · ${Math.round(s.durationSeconds/60*10)/10} min</div>
      </div>
      <button class="del" data-del="${s.id}">×</button>
    </div>
  `).join('');
}
function selectDay(key){
  selectedDay = key;
  renderCalendar();
}
function shiftMonth(delta){
  calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth()+delta, 1);
  renderCalendar();
}

// ---------- forecast tab ----------
async function getForecast(){
  const loc = document.getElementById('location-input').value.trim();
  if(!loc){ toast('Enter a location first'); return; }
  settings.location = loc;
  await saveJSON('settings', settings);

  const btn = document.getElementById('btn-get-forecast');
  btn.disabled = true;
  btn.textContent = 'Fetching forecast…';
  document.getElementById('forecast-meta').textContent = '';

  try{
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        messages: [{
          role: "user",
          content: `Search for the current 5-day weather forecast for ${loc}. Then respond with ONLY a raw JSON array (no markdown fences, no preamble, no commentary) of exactly 5 objects, one per upcoming day in order, each with these fields: "date" (short e.g. "Mon 11 Aug"), "condition" (short phrase e.g. "Light rain"), "highC" (number), "lowC" (number), "rainChancePercent" (number 0-100), "wateringAdvice" (one short specific sentence about whether/when to water an evergreen yew hedge that day, considering rain chance and heat — e.g. recommend early morning or evening watering on hot dry days, and recommend skipping watering if meaningful rain is expected).`
        }],
        tools: [{ type: "web_search_20250305", name: "web_search" }]
      })
    });
    const data = await response.json();
    const text = (data.content || [])
      .map(item => item.type === 'text' ? item.text : '')
      .filter(Boolean)
      .join('\n');
    const clean = text.replace(/```json/g,'').replace(/```/g,'').trim();
    const jsonStart = clean.indexOf('[');
    const jsonEnd = clean.lastIndexOf(']');
    const parsed = JSON.parse(clean.slice(jsonStart, jsonEnd+1));

    const cache = { location: loc, fetchedAt: new Date().toISOString(), days: parsed };
    await saveJSON('forecast-cache', cache);
    renderForecast(cache);
    toast('Forecast updated');
  }catch(e){
    console.error(e);
    document.getElementById('forecast-list').innerHTML = '<div class="empty">Could not fetch the forecast just now. Try again in a moment.</div>';
  }finally{
    btn.disabled = false;
    btn.textContent = 'Get forecast & watering advice';
  }
}
function renderForecast(cache){
  const listEl = document.getElementById('forecast-list');
  if(!cache || !cache.days || !cache.days.length){
    listEl.innerHTML = '<div class="empty">No forecast yet — enter your location above and fetch one.</div>';
    return;
  }
  listEl.innerHTML = cache.days.map(d => `
    <div class="forecast-card">
      <div class="top">
        <div class="date">${escapeHtml(d.date||'')}</div>
        <div class="temps">${d.highC!=null?d.highC+'°':''}${d.lowC!=null?' / '+d.lowC+'°':''}</div>
      </div>
      <div class="cond">${escapeHtml(d.condition||'')} ${d.rainChancePercent!=null? '· '+d.rainChancePercent+'% rain':''}</div>
      <div class="advice">${escapeHtml(d.wateringAdvice||'')}</div>
    </div>
  `).join('');
  const mins = Math.round((Date.now() - new Date(cache.fetchedAt).getTime())/60000);
  document.getElementById('forecast-meta').textContent =
    `${cache.location} · updated ${mins<1?'just now':mins+' min ago'}`;
}

// ---------- misc ----------
function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}
function switchTab(name){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('tab-'+name).classList.add('active');
  document.querySelectorAll('nav.tabbar button').forEach(b=>b.classList.toggle('active', b.dataset.tab===name));
}

function bindEvents(){
  document.querySelectorAll('nav.tabbar button').forEach(b=>{
    b.addEventListener('click', ()=>switchTab(b.dataset.tab));
  });

  document.getElementById('plant-grid').addEventListener('click', (e)=>{
    const card = e.target.closest('.plant-card');
    if(!card) return;
    pickCategory(card.dataset.cat);
  });
  document.getElementById('change-plant').addEventListener('click', ()=>{
    if(timer.running){ toast('Finish or stop the current round first'); return; }
    document.getElementById('round-setup').classList.add('hidden');
    document.getElementById('plant-picker').classList.remove('hidden');
    renderPlantGrid();
  });

  document.getElementById('toggle-add-cat').addEventListener('click', ()=>{
    document.getElementById('add-cat-form').classList.toggle('hidden');
  });
  document.getElementById('save-cat').addEventListener('click', async ()=>{
    const name = document.getElementById('new-cat-name').value.trim();
    const secs = parseInt(document.getElementById('new-cat-secs').value, 10) || 30;
    if(!name){ toast('Give the category a name'); return; }
    const id = 'c_' + Date.now();
    categories.push({id, name, seconds:secs, lastCount:1});
    await saveJSON('categories', categories);
    renderPlantGrid();
    renderStatStrip();
    document.getElementById('new-cat-name').value = '';
    document.getElementById('add-cat-form').classList.add('hidden');
    toast(`Added "${name}"`);
  });

  document.getElementById('btn-start').addEventListener('click', startTimer);
  document.getElementById('btn-pause').addEventListener('click', pauseTimer);
  document.getElementById('btn-stop').addEventListener('click', ()=>finishTimer(false));

  document.getElementById('cal-prev').addEventListener('click', ()=>shiftMonth(-1));
  document.getElementById('cal-next').addEventListener('click', ()=>shiftMonth(1));
  document.getElementById('cal-grid').addEventListener('click', (e)=>{
    const cell = e.target.closest('.cal-day');
    if(!cell || cell.classList.contains('blank')) return;
    selectDay(cell.dataset.day);
  });
  document.getElementById('day-detail').addEventListener('click', async (e)=>{
    const id = e.target.dataset.del;
    if(!id) return;
    sessions = sessions.filter(s=>s.id!==id);
    await saveJSON('sessions', sessions);
    renderCalendar();
  });

  document.getElementById('btn-get-forecast').addEventListener('click', getForecast);
}

init();
</script>
